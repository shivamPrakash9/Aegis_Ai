# Environment Configuration
NODE_ENV=development
PORT=3003
LOG_LEVEL=info

# Service Authentication & Internal Security
# Secret or public key used to verify caller JWTs or internal service tokens
PRIVACY_JWT_SECRET=aegis_privacy_dev_jwt_secret_change_in_production
PRIVACY_JWT_ISSUER=aegis-identity
PRIVACY_JWT_AUDIENCE=aegis-privacy
INTERNAL_SERVICE_KEY=aegis_internal_service_key_dev_only

# Identity Service integration for session/token verification (optional fallback)
IDENTITY_SERVICE_URL=http://localhost:3000

# Dedicated PostgreSQL Database (aegis_privacy)
PRIVACY_DATABASE_URL=postgresql://aegis_privacy_user:aegis_privacy_secure_password@localhost:5432/aegis_privacy?schema=public

# Scanner Protection & Content Limits
MAX_REQUEST_BODY_BYTES=1048576
MAX_CONTENT_LENGTH=50000
MAX_SCAN_ITEMS=100
SCAN_TIMEOUT_MS=5000

# Default Scanner Behavior
PRIVACY_DEFAULT_MODE=MASK
PRIVACY_RULESET_VERSION=1.0.0

# CORS & Network
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
