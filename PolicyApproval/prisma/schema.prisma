// Prisma Schema for AegisAI Policy & Approval Service
// Dedicated Database: aegis_policy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POLICY_DATABASE_URL")
}

model Policy {
  id            String          @id @default(uuid())
  organizationId String         @map("organization_id")
  name          String
  description   String?
  category      String          @default("GENERAL")
  priority      Int             @default(100)
  status        String          @default("ACTIVE")
  activeVersion Int             @default(1) @map("active_version")
  createdBy     String?         @map("created_by")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  versions      PolicyVersion[]
  approvals     ApprovalRequest[]

  @@index([organizationId, status])
  @@map("policies")
}

model PolicyVersion {
  id          String   @id @default(uuid())
  policyId    String   @map("policy_id")
  version     Int
  rules       String   @default("[]")
  description String?
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  policy      Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@index([policyId])
  @@map("policy_versions")
}

model ApprovalRequest {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  requestId      String?   @map("request_id")
  policyId       String?   @map("policy_id")
  policyVersion  Int?      @map("policy_version")
  ruleId         String?   @map("rule_id")
  reason         String
  modelRequested String?   @map("model_requested")
  status         String    @default("PENDING")
  requesterId    String    @map("requester_id")
  requesterRole  String?   @map("requester_role")
  requesterType  String    @default("USER") @map("requester_type")
  approverId     String?   @map("approver_id")
  approverRole   String?   @map("approver_role")
  decisionReason String?   @map("decision_reason")
  decisionAt     DateTime? @map("decision_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  policy         Policy?   @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([requestId])
  @@map("approval_requests")
}
