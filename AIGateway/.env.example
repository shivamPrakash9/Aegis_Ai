# AegisAI AI Gateway Environment Variables (Template)
PORT=3001
NODE_ENV=development

# Dedicated PostgreSQL Database (Separate from aegis_identity)
GATEWAY_DATABASE_URL="postgresql://aegis_gateway_user:aegis_gateway_secure_password@localhost:5432/aegis_gateway?schema=public"

# Distributed Redis Coordination (Idempotency and Rate Limiting)
REDIS_URL="redis://localhost:6379"

# Microservice REST Endpoints
IDENTITY_SERVICE_URL="http://localhost:3000"
PRIVACY_SCANNER_URL="http://localhost:3002"
POLICY_SERVICE_URL="http://localhost:3003"
MODEL_PROVIDER_SERVICE_URL="http://localhost:3004"
SECURITY_AUDIT_SERVICE_URL="http://localhost:3005"

# Idempotency and Rate Limiting Settings
IDEMPOTENCY_TTL_SECONDS=86400
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Resilience & Timeouts
REQUEST_TIMEOUT_MS=15000
MAX_REQUEST_BODY_BYTES=1048576

# Security & Logging
LOG_LEVEL=info
CORS_ORIGINS="*"
