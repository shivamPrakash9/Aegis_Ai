PORT=3004
NODE_ENV=development
LOG_LEVEL=info

# Dedicated PostgreSQL Database (aegis_model)
MODEL_DATABASE_URL=postgresql://aegis_model_user:aegis_model_secure_password@localhost:5432/aegis_model?schema=public

# Authentication & Service Trust
MODEL_JWT_SECRET=aegis_model_dev_jwt_secret_change_in_production
MODEL_JWT_ISSUER=aegis-identity
MODEL_JWT_AUDIENCE=aegis-model
INTERNAL_SERVICE_KEY=aegis_internal_service_key_dev_only

# Downstream / Peer Microservices
IDENTITY_SERVICE_URL=http://localhost:3000
AI_GATEWAY_URL=http://localhost:3001

# LLM Providers Configuration (Zero plaintext credentials in DB or logs)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Defaults & Routing
DEFAULT_MODEL=gemini-3.5-flash-lite
DEFAULT_PROVIDER=gemini

# Outbound Security & SSRF Protection
ALLOWED_PROVIDER_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com,127.0.0.1,localhost

# Limits & Timeouts
PROVIDER_TIMEOUT_MS=30000
MAX_REQUEST_BODY_BYTES=1048576
MAX_TOKENS_LIMIT=8192
CORS_ORIGINS=*
