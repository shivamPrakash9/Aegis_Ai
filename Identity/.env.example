# AegisAI Identity Service (Service 1) Environment Variables Example
# Copy to .env and configure values before starting the service.
# NEVER commit the actual .env file to version control.

# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Dedicated PostgreSQL Database Configuration
IDENTITY_DATABASE_URL=postgresql://aegis_id_user:aegis_id_password@localhost:5432/aegis_identity?schema=public
IDENTITY_DB_HOST=localhost
IDENTITY_DB_PORT=5432
IDENTITY_DB_NAME=aegis_identity
IDENTITY_DB_USER=aegis_id_user
IDENTITY_DB_PASSWORD=aegis_id_password

# JWT Authentication
# In production, use strong, unpredictable secrets (minimum 32 characters or random 256-bit entropy)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long!
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long!
JWT_REFRESH_TTL=7d
JWT_ISSUER=aegis-identity-service
JWT_AUDIENCE=aegis-gateway

# Administrative Bootstrap Key (Required for bootstrap endpoint/CLI to prevent unauthorized initial registrations)
ADMIN_BOOTSTRAP_KEY=bootstrap_secret_token_change_in_production_min_32_chars

# Optional Redis Configuration (for distributed rate limiting & token revocation cache)
# If omitted or unavailable, the service gracefully falls back to memory cache
# REDIS_URL=redis://localhost:6379
