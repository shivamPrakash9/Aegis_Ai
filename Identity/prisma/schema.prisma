// Prisma schema for AegisAI Identity Service (Service 1)
// Dedicated Database: aegis_identity

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("IDENTITY_DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserRole {
  ORGANIZATION_ADMIN
  DEVELOPER
  SECURITY_AUDITOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ServiceAccountStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

model Organization {
  id              String             @id @default(uuid())
  name            String
  slug            String             @unique
  status          OrganizationStatus @default(ACTIVE)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  users           User[]
  serviceAccounts ServiceAccount[]
  refreshTokens   RefreshToken[]

  @@map("organizations")
}

model User {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  email          String        @unique
  passwordHash   String        @map("password_hash")
  displayName    String        @map("display_name")
  role           UserRole      @default(DEVELOPER)
  status         UserStatus    @default(ACTIVE)
  lastLoginAt    DateTime?     @map("last_login_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@map("users")
}

model ServiceAccount {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  name           String
  keyPrefix      String               @unique @map("key_prefix")
  secretHash     String               @map("secret_hash")
  permissions    String               // JSON array of permission strings
  status         ServiceAccountStatus @default(ACTIVE)
  createdBy      String?              @map("created_by")
  lastUsedAt     DateTime?            @map("last_used_at")
  expiresAt      DateTime?            @map("expires_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyPrefix])
  @@index([status])
  @@map("service_accounts")
}

model RefreshToken {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  organizationId String       @map("organization_id")
  tokenHash      String       @unique @map("token_hash")
  familyId       String       @map("family_id")
  isRevoked      Boolean      @default(false) @map("is_revoked")
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}
