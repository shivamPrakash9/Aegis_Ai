# AegisAI Microservices Platform - Environment Configuration Template
# Copy this file to .env or configure environment variables for each service

NODE_ENV=development
LOG_LEVEL=info

# ==============================================================================
# Microservices Ports & Base URLs
# ==============================================================================
IDENTITY_PORT=3000
GATEWAY_PORT=3001
PRIVACY_PORT=3002
POLICY_PORT=3003
MODEL_PORT=3004
AUDIT_PORT=3005
FRONTEND_PORT=5173

IDENTITY_SERVICE_URL=http://localhost:3000
AIGATEWAY_SERVICE_URL=http://localhost:3001
PRIVACY_SCANNER_URL=http://localhost:3002
POLICY_SERVICE_URL=http://localhost:3003
MODEL_PROVIDER_SERVICE_URL=http://localhost:3004
SECURITY_AUDIT_SERVICE_URL=http://localhost:3005

# ==============================================================================
# Database Connections
# ==============================================================================
# Identity Service (PostgreSQL)
IDENTITY_DATABASE_URL=postgresql://aegis_identity_user:aegis_identity_secure_password@localhost:5432/aegis_identity?schema=public

# AI Gateway Service (PostgreSQL & Redis)
GATEWAY_DATABASE_URL=postgresql://aegis_gateway_user:aegis_gateway_secure_password@localhost:5432/aegis_gateway?schema=public
REDIS_URL=redis://localhost:6379

# Privacy Scanner Service (PostgreSQL)
PRIVACY_DATABASE_URL=postgresql://aegis_privacy_user:aegis_privacy_secure_password@localhost:5432/aegis_privacy?schema=public

# Policy Approval Service (PostgreSQL)
POLICY_DATABASE_URL=postgresql://aegis_policy_user:aegis_policy_secure_password@localhost:5432/aegis_policy?schema=public

# Model Provider Service (PostgreSQL)
MODEL_DATABASE_URL=postgresql://aegis_model_user:aegis_model_secure_password@localhost:5432/aegis_model?schema=public

# Security Audit Service (MongoDB)
AUDIT_MONGODB_URI=mongodb://localhost:27017/aegis_audit

# ==============================================================================
# Security & JWT Secrets
# ==============================================================================
JWT_SECRET=super_secret_enterprise_jwt_key_aegis_2026_min32chars
ADMIN_BOOTSTRAP_KEY=aegis_dev_bootstrap_key_2026
MODEL_PROVIDER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUDIT_HMAC_SECRET=aegis_audit_tamper_evident_hmac_secret_2026

# ==============================================================================
# Upstream LLM Provider Credentials (Optional for real execution)
# ==============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=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
