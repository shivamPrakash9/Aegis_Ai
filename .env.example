# Environment Configuration
NODE_ENV=development
PORT=3003
LOG_LEVEL=info

# Service Authentication & Internal Security
POLICY_JWT_SECRET=aegis_policy_dev_jwt_secret_change_in_production
POLICY_JWT_ISSUER=aegis-identity
POLICY_JWT_AUDIENCE=aegis-policy
INTERNAL_SERVICE_KEY=aegis_internal_service_key_dev_only

# Downstream / Peer Microservices
IDENTITY_SERVICE_URL=http://localhost:3000
AI_GATEWAY_URL=http://localhost:3001
PRIVACY_SCANNER_URL=http://localhost:3002

# Dedicated PostgreSQL Database (aegis_policy)
POLICY_DATABASE_URL=postgresql://aegis_policy_user:aegis_policy_secure_password@localhost:5432/aegis_policy?schema=public

# Limits & Timeouts
MAX_REQUEST_BODY_BYTES=1048576
MAX_RULES_PER_POLICY=50
MAX_CONDITION_DEPTH=5
REQUEST_TIMEOUT_MS=15000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
