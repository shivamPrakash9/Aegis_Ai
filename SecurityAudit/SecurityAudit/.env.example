# AegisAI Security & Audit Service Environment Configuration
PORT=3005
NODE_ENV=development
LOG_LEVEL=info

# Primary Persistent Storage: MongoDB
MONGODB_URI=mongodb://localhost:27017/aegis_audit
MONGODB_DATABASE=aegis_audit

# Internal Service-to-Service Authentication
INTERNAL_SERVICE_KEY=aegis_internal_service_secret_key_dev
JWT_SECRET=aegis_jwt_shared_secret_dev

# Downstream / Peer Microservices
AI_GATEWAY_URL=http://localhost:3001
IDENTITY_SERVICE_URL=http://localhost:3000

# Constraints and Limits
MAX_REQUEST_BODY_BYTES=262144
MAX_METADATA_DEPTH=5
MAX_QUERY_PAGE_SIZE=100
AUDIT_RETENTION_DAYS=90
