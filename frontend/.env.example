# =============================================================================
# AegisAI Frontend — Environment Configuration Template
# =============================================================================
# NOTE: All variables prefixed with VITE_ are embedded into the client browser bundle.
# NEVER store secrets, private JWT keys, database URLs, or provider API keys here!
# =============================================================================

# In local development, leave these blank or omit them to use the Vite development proxy
# (which proxies /api/* to the respective local microservice ports :3000 to :3005).

# Service 1: Identity Service (Port 3000)
# VITE_IDENTITY_API_URL=http://localhost:3000

# Service 2: AI Gateway Service (Port 3001)
# VITE_GATEWAY_API_URL=http://localhost:3001

# Service 3: Privacy Scanner Service (Port 3002)
# VITE_PRIVACY_API_URL=http://localhost:3002

# Service 4: Policy & Approval Service (Port 3003)
# VITE_POLICY_API_URL=http://localhost:3003

# Service 5: Model & Provider Service (Port 3004)
# VITE_MODEL_API_URL=http://localhost:3004

# Service 6: Security & Audit Service (Port 3005)
# VITE_AUDIT_API_URL=http://localhost:3005

# In production deployments, configure reverse-proxy paths or API gateway domain:
# VITE_GATEWAY_API_URL=https://gateway.aegisai.internal
# VITE_IDENTITY_API_URL=https://identity.aegisai.internal
